# Port the Express API server listens on
PORT=5000

# Redis connection string used by BullMQ for the forensic worker queue
# Local dev example: redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# Comma-separated list of allowed origins for CORS.
# Set this to your deployed frontend URL(s), e.g. https://reporter.example.com
# Leave unset in local dev to allow all origins.
CORS_ORIGIN=

# --- Real outbound integrations ---

# Free key from auth.abuse.ch - used ONLY to check the URLhaus blacklist
# (not for submission - URLhaus submission is restricted to active malware
# distribution sites and is not a fit for general phishing/scam reports).
URLHAUS_AUTH_KEY=

# Resend (https://resend.com) API key - required for abuse reports and
# Kominfo Aduan Konten emails to actually be sent. Without this, emails are
# only logged/saved locally and marked SIMULATED_NOT_SENT.
RESEND_API_KEY=
MAIL_FROM="Threat Reports <onboarding@resend.dev>"

# Optional override for the Kominfo content-abuse intake address.
KOMINFO_ADUAN_EMAIL=aduankonten@kominfo.go.id

# Optional override for the APWG (Anti-Phishing Working Group) intake
# address used by sendApwgReport(). Sent via Resend like the registrar
# abuse channel above.
APWG_REPORT_EMAIL=reportphishing@apwg.org

# Gmail API (OAuth2, HTTPS) credentials - used ONLY for sendKominfoReport().
# Kominfo's mail gateway consistently bounces mail sent via Resend/Amazon
# SES even with valid SPF/DKIM/DMARC on the sending domain, but accepts
# identical content sent from a Gmail mailbox (confirmed by manual testing).
# All other report channels (registrar/hosting abuse, APWG, Vercel abuse)
# still use Resend above.
#
# Sent via the Gmail REST API (https://gmail.googleapis.com) rather than
# SMTP, because many PaaS hosts block outbound SMTP ports (25/465/587) -
# the Gmail API is a plain HTTPS/443 call like any other Google API, so it
# works where SMTP doesn't.
#
# Setup (one-time, in Google Cloud Console):
#   1. Create/select a project, enable the "Gmail API".
#   2. Create an OAuth 2.0 Client ID (type: Desktop app) -> gives you
#      GMAIL_CLIENT_ID + GMAIL_CLIENT_SECRET.
#   3. Run the OAuth consent flow once for the sending mailbox with scope
#      https://www.googleapis.com/auth/gmail.send (e.g. via Google's
#      OAuth 2.0 Playground: https://developers.google.com/oauthplayground,
#      using your own client ID/secret under its settings gear icon) to
#      obtain a GMAIL_REFRESH_TOKEN.
# Without all four vars set, Kominfo reports are only logged/saved locally
# and marked SIMULATED_NOT_SENT, same fallback behavior as the Resend path.
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Free key from Google Cloud Console (enable the "Safe Browsing API") - used
# to VERIFY whether a URL is already known-malicious to Google. This is a
# check only; Google has no public API for submitting new URLs.
GOOGLE_SAFE_BROWSING_API_KEY=

# Cloudflare Turnstile SECRET key - required to verify the captcha_token sent
# by the frontend on /api/reports. Without this, ALL submissions are rejected
# with a CAPTCHA verification error (fail closed, not open).
# Must match the SITE key configured on the frontend (VITE_TURNSTILE_SITE_KEY).
# Create both for free at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
