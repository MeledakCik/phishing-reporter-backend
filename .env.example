# Port the Express API server listens on
PORT=5000

# Redis connection string used by BullMQ for the forensic worker queue
# Local dev example: redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# Comma-separated list of allowed origins for CORS.
# Set this to your deployed frontend URL(s), e.g. https://reporter.example.com
# Leave unset in local dev to allow all origins.
CORS_ORIGIN=

# --- Real outbound integrations ---

# Free key from auth.abuse.ch - used ONLY to check the URLhaus blacklist
# (not for submission - URLhaus submission is restricted to active malware
# distribution sites and is not a fit for general phishing/scam reports).
URLHAUS_AUTH_KEY=

# Resend (https://resend.com) API key - required for abuse reports and
# Kominfo Aduan Konten emails to actually be sent. Without this, emails are
# only logged/saved locally and marked SIMULATED_NOT_SENT.
RESEND_API_KEY=
MAIL_FROM="Threat Reports <onboarding@resend.dev>"

# Optional override for the Kominfo content-abuse intake address.
KOMINFO_ADUAN_EMAIL=aduankonten@kominfo.go.id

# Gmail SMTP credentials - used ONLY for sendKominfoReport(). Kominfo's mail
# gateway consistently bounces mail sent via Resend/Amazon SES even with
# valid SPF/DKIM/DMARC on the sending domain, but accepts identical content
# sent via Gmail SMTP (confirmed by manual testing). All other report
# channels (registrar/hosting abuse, Vercel abuse) still use Resend above.
#
# GMAIL_APP_PASSWORD is a 16-character App Password, NOT your regular Gmail
# login password. Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Google account first).
# Without these two vars set, Kominfo reports are only logged/saved locally
# and marked SIMULATED_NOT_SENT, same fallback behavior as the Resend path.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Free key from Google Cloud Console (enable the "Safe Browsing API") - used
# to VERIFY whether a URL is already known-malicious to Google. This is a
# check only; Google has no public API for submitting new URLs.
GOOGLE_SAFE_BROWSING_API_KEY=

# Cloudflare Turnstile SECRET key - required to verify the captcha_token sent
# by the frontend on /api/reports. Without this, ALL submissions are rejected
# with a CAPTCHA verification error (fail closed, not open).
# Must match the SITE key configured on the frontend (VITE_TURNSTILE_SITE_KEY).
# Create both for free at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
